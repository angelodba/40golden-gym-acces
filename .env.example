# Credenciales de Supabase (Copiar de tu proyecto en https://supabase.com)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Clave secreta HMAC-SHA256 para firma criptográfica de tokens QR
# IMPORTANTE: Cambiar a una cadena aleatoria segura de al menos 64 caracteres en producción
VITE_HMAC_SECRET=CAMBIAR_A_CLAVE_SEGURA_ALEATORIA_DE_64_CHARS_EN_PRODUCCION
